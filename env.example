# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/saku_ai_db"

# Backend Python Service URL
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-secret-key-here-change-this-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# App URL Configuration (for production)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Google OAuth Configuration (if needed)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Polar Configuration
POLAR_ACCESS_TOKEN=""
POLAR_PRODUCT_ID=""

# Inngest Configuration
INNGEST_EVENT_KEY=""

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual credentials
# 3. For Inngest, you can either:
#    - Set INNGEST_EVENT_KEY to your actual Inngest event key
#    - Or leave it empty to disable Inngest (workflows won't execute but won't error)
# 4. Never commit .env.local to version control

